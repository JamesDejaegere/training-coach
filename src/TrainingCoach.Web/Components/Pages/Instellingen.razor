@page "/instellingen"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using TrainingCoach.Infrastructure.Analytics
@using TrainingCoach.Infrastructure.Persistence
@using TrainingCoach.Infrastructure.Polar
@using TrainingCoach.Infrastructure.Strava
@inject AthleteSettingsStore SettingsStore
@inject StravaSyncService Strava
@inject PolarSyncService Polar
@inject IOptions<StravaOptions> StravaOptions
@inject IOptions<PolarOptions> PolarOptions
@inject NavigationManager Navigation

<PageTitle>Instellingen</PageTitle>

<h1>Instellingen</h1>

<h2>Atleet</h2>

<section class="card mb-3">
    <div class="card-body">
        @if (settings is null)
        {
            <p>Laden…</p>
        }
        else
        {
            <div class="row g-3">
                <div class="col-sm-4">
                    <label class="form-label" for="hrmax">Maximale hartslag (bpm)</label>
                    <input id="hrmax" type="number" class="form-control" @bind="settings.HrMax" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="hrrest">Rusthartslag overschrijven (bpm)</label>
                    <input id="hrrest" type="number" class="form-control" placeholder="automatisch uit Polar" @bind="settings.RestingHrOverride" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="radius">Straal pendelherkenning (m)</label>
                    <input id="radius" type="number" class="form-control" @bind="settings.CommuteRadiusMeters" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="homelat">Thuis – breedtegraad</label>
                    <input id="homelat" type="number" step="any" class="form-control" @bind="settings.HomeLatitude" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="homelon">Thuis – lengtegraad</label>
                    <input id="homelon" type="number" step="any" class="form-control" @bind="settings.HomeLongitude" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="worklat">Werk – breedtegraad</label>
                    <input id="worklat" type="number" step="any" class="form-control" @bind="settings.WorkLatitude" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label" for="worklon">Werk – lengtegraad</label>
                    <input id="worklon" type="number" step="any" class="form-control" @bind="settings.WorkLongitude" />
                </div>
            </div>
            <p class="small text-muted mt-2">
                Thuis en werk worden gebruikt om pendelritten te herkennen. Je vindt de coördinaten door in Google Maps met rechtermuisknop op de plaats te klikken.
            </p>
            <button class="btn btn-primary" @onclick="SaveSettings">Opslaan</button>
            @if (settingsMessage is not null) { <span class="ms-2 @(settingsOk ? "text-success" : "text-danger")">@settingsMessage</span> }
        }
    </div>
</section>

<h2>Verbindingen</h2>

@if (Melding is not null)
{
    <div class="alert @Melding.Value.Klasse" role="alert">@Melding.Value.Tekst</div>
}

<section class="card mb-3">
    <div class="card-body">
        <h3 class="h5">Strava</h3>

        @if (!StravaOptions.Value.IsConfigured)
        {
            <p>
                De Strava-gegevens ontbreken. Stel <code>Strava:ClientId</code> en <code>Strava:ClientSecret</code> in met
                <em>dotnet user-secrets</em> en start de app opnieuw.
            </p>
        }
        else if (stravaStatus is null)
        {
            <p>Laden…</p>
        }
        else if (!stravaStatus.Connected)
        {
            <p>Niet verbonden.</p>
            <a class="btn btn-primary" href="/connect/strava">Verbinden met Strava</a>
        }
        else
        {
            <p>
                Verbonden. @stravaStatus.ActivityCount activiteiten.
                @if (stravaStatus.LastSyncUtc is { } laatste)
                {
                    <span>Laatst gesynchroniseerd: @laatste.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</span>
                }
                else
                {
                    <span>Nog niet gesynchroniseerd.</span>
                }
            </p>
            <button class="btn btn-primary" @onclick="SyncStrava" disabled="@bezig">
                @(bezig ? "Bezig met synchroniseren…" : "Nu synchroniseren")
            </button>
            <a class="btn btn-outline-secondary ms-2" href="/connect/strava">Opnieuw verbinden</a>
        }
    </div>
</section>

<section class="card mb-3">
    <div class="card-body">
        <h3 class="h5">Polar</h3>

        @if (!PolarOptions.Value.IsConfigured)
        {
            <p>
                De Polar-gegevens ontbreken. Stel <code>Polar:ClientId</code> en <code>Polar:ClientSecret</code> in met
                <em>dotnet user-secrets</em> en start de app opnieuw.
            </p>
        }
        else if (polarStatus is null)
        {
            <p>Laden…</p>
        }
        else if (!polarStatus.Connected)
        {
            <p>Niet verbonden. Polar geeft alleen trainingen door die na het verbinden worden geüpload (en maximaal 30 dagen terug).</p>
            <a class="btn btn-primary" href="/connect/polar">Verbinden met Polar</a>
        }
        else
        {
            <p>
                Verbonden. @polarStatus.ActivityCount trainingen en @polarStatus.RecoveryDayCount nachten herstel.
                @if (polarStatus.LastSyncUtc is { } laatstePolar)
                {
                    <span>Laatst gesynchroniseerd: @laatstePolar.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</span>
                }
                else
                {
                    <span>Nog niet gesynchroniseerd.</span>
                }
            </p>
            <button class="btn btn-primary" @onclick="SyncPolar" disabled="@bezig">
                @(bezig ? "Bezig met synchroniseren…" : "Nu synchroniseren")
            </button>
            <a class="btn btn-outline-secondary ms-2" href="/connect/polar">Opnieuw verbinden</a>
        }
    </div>
</section>

@code {
    private AthleteSettingsEntity? settings;
    private string? settingsMessage;
    private bool settingsOk;
    private StravaStatus? stravaStatus;
    private PolarStatus? polarStatus;
    private bool bezig;
    private (string Klasse, string Tekst)? Melding;

    protected override async Task OnInitializedAsync()
    {
        var parameters = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        Melding = (parameters["fout"], parameters["verbonden"], parameters["polar-verbonden"]) switch
        {
            ("niet-geconfigureerd", _, _) => ("alert-danger", "Strava is nog niet geconfigureerd."),
            ("polar-niet-geconfigureerd", _, _) => ("alert-danger", "Polar is nog niet geconfigureerd."),
            ("ongeldige-state", _, _) => ("alert-danger", "De verbinding kon niet worden bevestigd. Probeer opnieuw."),
            ("geweigerd", _, _) => ("alert-warning", "Je hebt de toegang tot Strava geweigerd."),
            ("polar-geweigerd", _, _) => ("alert-warning", "Je hebt de toegang tot Polar geweigerd."),
            ("onvoldoende-rechten", _, _) => ("alert-warning", "Vink bij Strava ‘Bekijk je privéactiviteiten’ aan, anders kan niet alles worden geïmporteerd."),
            (_, "1", _) => ("alert-success", "Verbonden met Strava. De volledige historiek wordt op de achtergrond geïmporteerd."),
            (_, _, "1") => ("alert-success", "Verbonden met Polar. Trainingen en herstel worden op de achtergrond opgehaald."),
            _ => null,
        };

        settings = await SettingsStore.GetAsync();
        if (StravaOptions.Value.IsConfigured)
            stravaStatus = await Strava.GetStatusAsync();
        if (PolarOptions.Value.IsConfigured)
            polarStatus = await Polar.GetStatusAsync();
    }

    private async Task SaveSettings()
    {
        try
        {
            await SettingsStore.SaveAsync(settings!);
            settingsOk = true;
            settingsMessage = "Opgeslagen.";
        }
        catch (ArgumentOutOfRangeException ex)
        {
            settingsOk = false;
            settingsMessage = ex.Message.Replace("Max HR", "Maximale hartslag").Replace("Resting HR", "Rusthartslag");
        }
    }

    private async Task SyncStrava()
    {
        await Run(async () =>
        {
            var result = await Strava.SyncAsync();
            Melding = result.Status switch
            {
                SyncStatus.Ok => ("alert-success", $"Strava klaar: {result.Added} nieuwe en {result.Updated} bijgewerkte activiteiten."),
                SyncStatus.RateLimited => ("alert-warning", $"Strava-limiet bereikt ({result.Added} nieuwe activiteiten opgehaald). De rest volgt bij de volgende synchronisatie."),
                SyncStatus.AuthFailed => ("alert-danger", "Strava weigert de toegang. Verbind opnieuw."),
                _ => ("alert-warning", "Niet verbonden met Strava."),
            };
            stravaStatus = await Strava.GetStatusAsync();
        });
    }

    private async Task SyncPolar()
    {
        await Run(async () =>
        {
            var result = await Polar.SyncAsync();
            Melding = result.Status switch
            {
                SyncStatus.Ok => ("alert-success", $"Polar klaar: {result.Added} nieuwe trainingen, {result.Merged} samengevoegd met Strava, {result.Updated} bijgewerkt, {result.RecoveryDays} nachten herstel."),
                SyncStatus.RateLimited => ("alert-warning", "Polar-limiet bereikt. Probeer later opnieuw."),
                SyncStatus.AuthFailed => ("alert-danger", "Polar weigert de toegang of de toegang is verlopen. Verbind opnieuw."),
                _ => ("alert-warning", "Niet verbonden met Polar."),
            };
            polarStatus = await Polar.GetStatusAsync();
        });
    }

    private async Task Run(Func<Task> action)
    {
        bezig = true;
        Melding = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Melding = ("alert-danger", $"Synchronisatie mislukt: {ex.Message}");
        }
        finally
        {
            bezig = false;
        }
    }
}
