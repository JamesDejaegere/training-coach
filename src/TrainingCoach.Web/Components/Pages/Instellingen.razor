@page "/instellingen"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using TrainingCoach.Infrastructure.Strava
@inject StravaSyncService Strava
@inject IOptions<StravaOptions> StravaOptions
@inject NavigationManager Navigation

<PageTitle>Instellingen</PageTitle>

<h1>Instellingen</h1>

<h2>Verbindingen</h2>

@if (Melding is not null)
{
    <div class="alert @Melding.Value.Klasse" role="alert">@Melding.Value.Tekst</div>
}

<section class="card mb-3">
    <div class="card-body">
        <h3 class="h5">Strava</h3>

        @if (!StravaOptions.Value.IsConfigured)
        {
            <p>
                De Strava-gegevens ontbreken. Stel <code>Strava:ClientId</code> en <code>Strava:ClientSecret</code> in met
                <em>dotnet user-secrets</em> en start de app opnieuw.
            </p>
        }
        else if (status is null)
        {
            <p>Laden…</p>
        }
        else if (!status.Connected)
        {
            <p>Niet verbonden.</p>
            <a class="btn btn-primary" href="/connect/strava">Verbinden met Strava</a>
        }
        else
        {
            <p>
                Verbonden. @status.ActivityCount activiteiten.
                @if (status.LastSyncUtc is { } laatste)
                {
                    <span>Laatst gesynchroniseerd: @laatste.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</span>
                }
                else
                {
                    <span>Nog niet gesynchroniseerd.</span>
                }
            </p>
            <button class="btn btn-primary" @onclick="SyncNu" disabled="@bezig">
                @(bezig ? "Bezig met synchroniseren…" : "Nu synchroniseren")
            </button>
            <a class="btn btn-outline-secondary ms-2" href="/connect/strava">Opnieuw verbinden</a>
        }
    </div>
</section>

@code {
    private StravaStatus? status;
    private bool bezig;
    private (string Klasse, string Tekst)? Melding;

    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(Navigation.Uri).Query;
        var parameters = System.Web.HttpUtility.ParseQueryString(query);
        Melding = (parameters["fout"], parameters["verbonden"]) switch
        {
            ("niet-geconfigureerd", _) => ("alert-danger", "Strava is nog niet geconfigureerd."),
            ("ongeldige-state", _) => ("alert-danger", "De verbinding kon niet worden bevestigd. Probeer opnieuw."),
            ("geweigerd", _) => ("alert-warning", "Je hebt de toegang tot Strava geweigerd."),
            ("onvoldoende-rechten", _) => ("alert-warning", "Vink bij Strava ‘Bekijk je privéactiviteiten’ aan, anders kan niet alles worden geïmporteerd."),
            (_, "1") => ("alert-success", "Verbonden met Strava. De volledige historiek wordt op de achtergrond geïmporteerd."),
            _ => null,
        };

        if (StravaOptions.Value.IsConfigured)
            status = await Strava.GetStatusAsync();
    }

    private async Task SyncNu()
    {
        bezig = true;
        Melding = null;
        try
        {
            var result = await Strava.SyncAsync();
            Melding = result.Status switch
            {
                SyncStatus.Ok => ("alert-success", $"Klaar: {result.Added} nieuwe en {result.Updated} bijgewerkte activiteiten."),
                SyncStatus.RateLimited => ("alert-warning", $"Strava-limiet bereikt ({result.Added} nieuwe activiteiten opgehaald). De rest volgt bij de volgende synchronisatie."),
                SyncStatus.AuthFailed => ("alert-danger", "Strava weigert de toegang. Verbind opnieuw."),
                _ => ("alert-warning", "Niet verbonden met Strava."),
            };
            status = await Strava.GetStatusAsync();
        }
        catch (Exception ex)
        {
            Melding = ("alert-danger", $"Synchronisatie mislukt: {ex.Message}");
        }
        finally
        {
            bezig = false;
        }
    }
}
